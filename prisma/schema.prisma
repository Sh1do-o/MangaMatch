// Prisma schema — defines the Manga model and SQLite datasource.
// Supports multi-session isolation (guest sessions) and Turso cloud libSQL on Vercel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Manga {
  id                Int      @id @default(autoincrement())
  sessionId         String   @default("default")
  anilistId         Int
  title             String
  genres            String   // stored as comma-separated
  coverUrl          String?
  synopsis          String?
  publicationStatus String?  // e.g. "Publishing", "Finished"
  readingStatus     String   @default("planning") // "reading" | "completed" | "planning"
  rating            Int?
  authors           String?  // comma-separated
  publishedFrom     String?
  publishedTo       String?
  chapters          Int?
  volumes           Int?
  malScore          Float?
  siteUrl           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  categories        Category[]

  @@unique([sessionId, anilistId])
  @@index([sessionId])
}

model Category {
  id        Int      @id @default(autoincrement())
  sessionId String   @default("default")
  name      String
  color     String   @default("#E8C77E") // hex color for the tag chip
  createdAt DateTime @default(now())
  manga     Manga[]

  @@unique([sessionId, name])
  @@index([sessionId])
}
